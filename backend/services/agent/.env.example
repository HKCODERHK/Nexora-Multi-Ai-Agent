PORT=8003
MONGODB_URI=
REDIS_URL=redis://localhost:6379
CHAT_SERVICE=http://localhost:8002
AUTH_SERVICE=http://localhost:8001
# same random value on the gateway and every service, e.g. node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))"
INTERNAL_API_KEY=
# LLMs, embeddings and web search
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Qdrant (include the port, e.g. https://xxxx.cloud.qdrant.io:6333 or http://localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# npm run eval only ever uses a LOCAL Qdrant (default http://localhost:6333)
EVAL_QDRANT_URL=http://localhost:6333
# S3 for generated PDFs / PPTs / images
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
